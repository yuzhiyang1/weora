# 应用
WEORA_APP_NAME=Weora API
WEORA_ENVIRONMENT=development
WEORA_API_PREFIX=/api/v1
WEORA_DATABASE_URL=postgresql+asyncpg://weora:请替换为本地密码@127.0.0.1:5432/weora
WEORA_REGISTRATION_ENABLED=true
WEORA_SESSION_COOKIE_SECURE=false
# 仅用于本地开发。production 环境即使误开也不会绕过密码校验。
WEORA_DEVELOPMENT_AUTH_BYPASS_ENABLED=false

# JSON 数组格式由 pydantic-settings 解析。
WEORA_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 对象存储默认显式禁用，不会回退到本地磁盘。
WEORA_OBJECT_STORAGE_PROVIDER=disabled
WEORA_OBJECT_STORAGE_BUCKET=
WEORA_OBJECT_STORAGE_REGION=
WEORA_OBJECT_STORAGE_ENDPOINT=
WEORA_OBJECT_STORAGE_PREFIX=weora/development
WEORA_OBJECT_STORAGE_USE_CNAME=false
WEORA_OBJECT_STORAGE_CONNECT_TIMEOUT_SECONDS=5
WEORA_OBJECT_STORAGE_READ_TIMEOUT_SECONDS=30
WEORA_OBJECT_STORAGE_MAX_ATTEMPTS=3

# 本地联调可填写最小权限 RAM 用户或 STS 凭据。不要提交真实值。
WEORA_OBJECT_STORAGE_ACCESS_KEY_ID=
WEORA_OBJECT_STORAGE_ACCESS_KEY_SECRET=
WEORA_OBJECT_STORAGE_SECURITY_TOKEN=

# Pi 执行：默认禁用，不自动读取个人 Pi/DeepSeek 配置，所有工具经过平台 Gateway。
# 启用前构建 runtimes/pi，并填写管理员控制的绝对入口路径、明确模型名和后端密钥。
WEORA_RUN_RUNTIME=disabled
WEORA_PI_NODE_EXECUTABLE=node
WEORA_PI_RUNTIME_ENTRY=
# 可选，使用固定 Bun 版本和 OMP 入口；未配置时设置页禁用 OMP。
WEORA_OMP_BUN_EXECUTABLE=bun
WEORA_OMP_RUNTIME_ENTRY=
WEORA_PI_MODEL=
WEORA_DEEPSEEK_API_KEY=
WEORA_RUN_MODEL_MAX_TOKENS=4096
WEORA_RUN_MODEL_TIMEOUT_SECONDS=120
# 整体执行上限，包含材料准备与工具；命令自身仍受审批与沙箱时限约束。
WEORA_RUN_EXECUTION_TIMEOUT_SECONDS=1800
WEORA_RUN_LEASE_SECONDS=30
WEORA_CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# 飞书凭据加密（Fernet key）与游标签名（至少32字节）必须同时配置。
# 使用部署密钥管理，不提交真实值；未配置时上下文接口明确返回503。
WEORA_CONTEXT_ENCRYPTION_KEY=
WEORA_CONTEXT_CURSOR_KEY=
WEORA_CONTEXT_RETENTION_DAYS=7
# 飞书消息读取可选 cli（固定 1.0.80）；默认 http，可显式回滚，不自动降级。
# Windows 填 npm 包 bin/lark-cli.exe，不填 lark-cli.ps1；Linux 填原生二进制绝对路径。
WEORA_FEISHU_READER_BACKEND=http
# WEORA_FEISHU_CLI_EXECUTABLE=D:/usr/local/node_modules/@larksuite/cli/bin/lark-cli.exe
WEORA_FEISHU_CLI_TIMEOUT_SECONDS=2.5
# WEORA_CONSOLE_PUBLIC_URL=https://weora.example.com

# 首版单个测试仓库，必须绑定工作空间；以下配置按需取消注释，不填空UUID。
# WEORA_READONLY_REPOSITORY_PATH=D:/isolated-test-repository
# WEORA_READONLY_REPOSITORY_WORKSPACE_ID=实际工作空间UUID
# 动态项目多仓只读：由后台准备固定 Git 对象，不执行检出、脚本、子模块或推送。
# 未配置缓存目录时保留历史资料型任务，不隐式联网；私有 HTTPS 在 Console 填 Git 用户名和 Git 密码/令牌。
# WEORA_REPOSITORY_CACHE_PATH=D:/isolated/weora-repository-cache
# 完成固定镜像/工作空间配置后，管理员可启用选中项目仓库的审批后隔离执行；默认关闭。
WEORA_PROJECT_SANDBOX_ENABLED=false

# 独立虚拟电脑通过 compose.computers.yaml 启用，示例保持关闭。
# WEORA_COMPUTER_SUPERVISOR_URL=http://computer-supervisor:4300
# WEORA_COMPUTER_SUPERVISOR_TOKEN=
# WEORA_COMPUTER_MASTER_TOKEN=
# WEORA_COMPUTER_BROWSER_ORIGINS=["http://computer-test:8080"]
# WEORA_COMPUTER_FEISHU_SCOPES={}
# 可为项目选择另一个管理员核验的固定镜像；不接受 tag/latest，执行期仍无网络。
# WEORA_PROJECT_SANDBOX_IMAGE=sha256:完整64位镜像ID
# Java 多模块构建预算只绑定上述项目镜像；不会放宽默认浏览器沙箱，也不能启用网络。
# WEORA_PROJECT_SANDBOX_RESOURCES={"memory_mb":3072,"cpus":2,"pids":256,"timeout_seconds":600,"output_bytes":262144,"workspace_mb":1024,"temporary_mb":256}
# 默认拒绝私网地址和非标准端口；只有管理员能登记精确 origin（不要通配放行）。
WEORA_REPOSITORY_PRIVATE_ORIGINS=[]
# 仅私有 CA 场景登记绝对证书路径，不关闭 TLS 校验。
WEORA_REPOSITORY_TLS_CA_FILES={}
# 每次克隆监测上限 128 MiB；是过程监测，不是容器硬盘配额或全局缓存配额。
WEORA_REPOSITORY_SNAPSHOT_MAX_BYTES=134217728
# WEORA_SANDBOX_WORKSPACE_ID=实际工作空间UUID
# WEORA_SANDBOX_IMAGE=registry/weora-sandbox@sha256:完整64位digest
# 本地构建也可使用完整 sha256:镜像ID；不接受 tag/latest 或短 ID。
# 默认直接执行 docker；以下可信固定 argv 仅供 Windows 桥接本机 WSL，不由模型传入。
# WEORA_SANDBOX_CLI_EXECUTABLE=C:/Windows/System32/wsl.exe
# WEORA_SANDBOX_CLI_ARGS=["-d","Ubuntu","-u","root","--exec","docker","--host","unix:///var/run/docker.sock","--config","/var/lib/weora/docker-cli"]
# WEORA_SANDBOX_REPOSITORY_ID=test-repository
# WEORA_SANDBOX_REPOSITORY_ARCHIVE=D:/isolated/test-repository.tar
# WEORA_SANDBOX_REPOSITORY_REVISION=完整提交SHA
# WEORA_SANDBOX_REPOSITORY_SHA256=tar文件SHA256
# WEORA_SANDBOX_BROWSER_PORT=3000

# 仅测试远端的GitHub App，私钥和安装令牌只在后台内存代理，不下放沙箱。
# WEORA_GITHUB_APP_ID=实际AppID
# WEORA_GITHUB_INSTALLATION_ID=实际安装ID
# WEORA_GITHUB_PRIVATE_KEY="PEM私钥，由本地安全配置提供"
# WEORA_GITHUB_REMOTE_ID=test-remote
# WEORA_GITHUB_REPOSITORY=owner/test-repository
# WEORA_GITHUB_TARGET_BRANCH=main

# 可替换代码托管连接：数组登记多仓库，秘密仅从独立引用映射读取。
# 详细字段与安全配置见 docs/development/weora-w10-code-hosting.md。
# 云效新版草稿创建未验证，默认拒绝创建，不降级正式评审；没有默认 GitLab 实现。
WEORA_HOSTING_CONNECTIONS=[]
WEORA_HOSTING_CREDENTIALS={}
# API 身份可以引用管理员指定的绝对文件路径；不把 API 令牌混入 Git 密码。
WEORA_HOSTING_API_TOKEN_FILES={}
